{
  "name": "carbonwire",
  "displayName": "CarbonWire",
  "description": "Test REST APIs with a fast HTTP client. Send requests, inspect JSON responses, and import collections from Postman, Insomnia, Bruno, HTTPie and curl, kept as plain files in your workspace.",
  "version": "1.0.0",
  "publisher": "carbonconfig",
  "author": "CarbonConfig",
  "license": "MIT",
  "private": true,
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1b1f27",
    "theme": "dark"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "rest-client",
    "api-client",
    "http-client",
    "api-testing",
    "rest-api",
    "postman",
    "insomnia",
    "bruno",
    "httpie",
    "hoppscotch",
    "curl",
    "opencollection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/carbonconfig/CarbonWire_VSCode.git"
  },
  "homepage": "https://github.com/carbonconfig/CarbonWire_VSCode#readme",
  "bugs": {
    "url": "https://github.com/carbonconfig/CarbonWire_VSCode/issues"
  },
  "qna": "https://github.com/carbonconfig/CarbonWire_VSCode/issues",
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=24"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:carbonwire.request",
    "onWebviewPanel:carbonwire.settings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "carbonwire",
          "title": "CarbonWire",
          "icon": "media/carbonwire.svg"
        }
      ],
      "panel": [
        {
          "id": "carbonwire-console",
          "title": "CarbonWire",
          "icon": "media/carbonwire.svg"
        }
      ]
    },
    "views": {
      "carbonwire": [
        {
          "type": "webview",
          "id": "carbonwire.sidebar",
          "name": "Collections"
        }
      ],
      "carbonwire-console": [
        {
          "type": "webview",
          "id": "carbonwire.console",
          "name": "Console"
        }
      ]
    },
