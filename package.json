    "configuration": {
      "title": "CarbonWire",
      "properties": {
        "carbonwire.collectionsFolder": {
          "type": "string",
          "default": "api-collections",
          "markdownDescription": "Where new collections are created, relative to the first workspace folder. Leave empty for the workspace folder itself. Existing collections are found anywhere in the workspace.",
          "order": 1
        },
        "carbonwire.environmentsFolder": {
          "type": "string",
          "default": "api-collections/environments",
          "markdownDescription": "Where environments are kept, relative to the first workspace folder. Environments are shared by every collection.",
          "order": 2
        },
        "carbonwire.responseSizeLimit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "markdownDescription": "Response size limit in megabytes. Larger response bodies are cut short in memory; the full size is still shown.",
          "order": 3
        },
        "carbonwire.historySize": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "markdownDescription": "How many recent requests to keep in history, on this device only. Set to `0` to turn history off.",
          "order": 4
        },
        "carbonwire.wrapLongLines": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Wrap long lines in responses instead of scrolling sideways. Also on the response toolbar.",
          "order": 5
        },
        "carbonwire.verifyTlsCertificates": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Verify TLS certificates. Turn off only for local servers with self-signed certificates.",
          "order": 6
        },
        "carbonwire.proxy": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "environment",
            "custom",
            "direct"
          ],
          "enumItemLabels": [
            "Auto",
            "VS Code's proxy settings",
            "Environment variables",
            "Custom",
            "Direct"
          ],
          "markdownEnumDescriptions": [
            "Use VS Code's proxy settings when a proxy is set in `#http.proxy#` or in the `HTTP_PROXY` or `HTTPS_PROXY` environment variables. Otherwise connect directly.",
            "Always go through VS Code's proxy support, including a proxy from your system settings. Connections aren't reused between requests, so each request is slower.",
            "Use the proxy in the `HTTP_PROXY`, `HTTPS_PROXY` or `ALL_PROXY` environment variables, skipping hosts in `NO_PROXY`. HTTP, HTTPS and SOCKS5 proxies work, and connections are reused.",
            "Use the proxy in `#carbonwire.proxyUrl#`, skipping the hosts in `#carbonwire.proxyBypass#`. HTTP, HTTPS and SOCKS5 proxies work, and connections are reused.",
            "Always connect directly. Connections are reused between requests, and the timeline shows DNS, connect and TLS times."
          ],
          "default": "auto",
          "markdownDescription": "How requests reach the server.",
          "order": 7
        },
        "carbonwire.keepHiddenTabsLoaded": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep CarbonWire tabs loaded while they're hidden, so switching back to one is instant. Each open tab then uses more memory. Applies to tabs opened after the change.",
          "order": 12
        },
        "carbonwire.proxyUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "The proxy for **Custom**: `http://proxy:3128`, `https://proxy:443` or `socks5://user@proxy:1080`. Set the password with the **CarbonWire: Set proxy password** command; it's kept in VS Code's secret storage, never in settings.",
          "order": 8
        },
        "carbonwire.proxyBypass": {
          "type": "string",
          "default": "localhost, 127.0.0.1, ::1",
          "markdownDescription": "Hosts that skip the custom proxy, separated by commas: `example.com` (and its subdomains), `.internal`, `host:8443`, or `*` for all.",
          "order": 9
        },
        "carbonwire.clientCertificates": {
          "type": "array",
          "default": [],
          "order": 10,
          "markdownDescription": "Client certificates for mutual TLS, by host. Paths may be relative to the first workspace folder. Set a key's passphrase with the **CarbonWire: Set client certificate passphrase** command.",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "description": "api.example.com, *.example.com, or with a port: api.example.com:8443"
              },
              "certificate": {
                "type": "string",
                "description": "PEM certificate file"
              },
              "key": {
                "type": "string",
                "description": "PEM private key file (PKCS #8, PKCS #1 or SEC1, optionally encrypted)"
              },
              "pfx": {
                "type": "string",
                "description": "PKCS #12 file (.pfx or .p12), in place of a certificate and key"
              }
            }
          }
        },
        "carbonwire.caCertificates": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "order": 11,
          "markdownDescription": "PEM files of certificate authorities to trust besides your system's, such as a company's internal CA. Paths may be relative to the first workspace folder."
        }
      }
    }
